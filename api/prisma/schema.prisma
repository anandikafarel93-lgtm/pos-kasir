generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id          BigInt         @id @default(autoincrement())
  name        String         @db.VarChar(50)
  code        role_code_enum @unique
  description String?        @db.VarChar(255)
  created_at  DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?      @default(now()) @db.Timestamptz(6)
  users       users[]
}

model users {
  id            BigInt    @id @default(autoincrement())
  role_id       BigInt
  name          String    @db.VarChar(100)
  username      String    @unique @db.VarChar(50)
  email         String?   @unique @db.VarChar(100)
  password      String    @db.VarChar(255)
  pin_code      String?   @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  is_active     Boolean   @default(true)
  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  orders        orders[]
  roles         roles     @relation(fields: [role_id], references: [id], map: "fk_users_role")

  @@index([is_active], map: "idx_users_is_active")
  @@index([role_id], map: "idx_users_role_id")
  @@index([username], map: "idx_users_username")
}

model categories {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.VarChar(50)
  slug       String     @unique @db.VarChar(60)
  icon       String?    @db.VarChar(50)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  products   products[]
}

model products {
  id              BigInt        @id @default(autoincrement())
  category_id     BigInt
  sku             String?       @unique @db.VarChar(30)
  name            String        @db.VarChar(150)
  description     String?
  cost_price      Decimal       @default(0) @db.Decimal(12, 2)
  price           Decimal       @default(0) @db.Decimal(12, 2)
  stock           Int           @default(0)
  image_url       String?       @db.VarChar(255)
  kitchen_station String?       @default("dapur_utama") @db.VarChar(50)
  is_active       Boolean       @default(true)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  points          Int           @default(0)
  order_items     order_items[]
  categories      categories    @relation(fields: [category_id], references: [id], map: "fk_products_category")

  @@index([category_id], map: "idx_products_category_id")
}

model order_items {
  id             BigInt              @id @default(autoincrement())
  order_id       BigInt
  product_id     BigInt
  quantity       Int                 @default(1)
  unit_price     Decimal             @db.Decimal(12, 2)
  subtotal       Decimal             @db.Decimal(12, 2)
  notes          String?
  kitchen_status kitchen_status_enum @default(MENUNGGU)
  created_at     DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?           @default(now()) @db.Timestamptz(6)
  orders         orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_order_items_order")
  products       products            @relation(fields: [product_id], references: [id], map: "fk_order_items_product")

  @@index([kitchen_status], map: "idx_order_items_kitchen_status")
  @@index([order_id], map: "idx_order_items_order_id")
}

model orders {
  id              BigInt            @id @default(autoincrement())
  order_number    String            @unique @db.VarChar(50)
  user_id         BigInt
  table_id        BigInt?
  customer_name   String?           @db.VarChar(100)
  order_type      order_type_enum   @default(DINE_IN)
  status          order_status_enum @default(PENDING)
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal           @default(0) @db.Decimal(12, 2)
  discount_amount Decimal           @default(0) @db.Decimal(12, 2)
  total_amount    Decimal           @default(0) @db.Decimal(12, 2)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  customer_id     BigInt?
  order_items     order_items[]
  customers       customers?        @relation(fields: [customer_id], references: [id], map: "fk_orders_customer")
  tables          tables?           @relation(fields: [table_id], references: [id], map: "fk_orders_table")
  users           users             @relation(fields: [user_id], references: [id], map: "fk_orders_user")
  payments        payments?

  @@index([created_at], map: "idx_orders_created_at")
  @@index([table_id], map: "idx_orders_table_id")
  @@index([user_id], map: "idx_orders_user_id")
  @@index([customer_id], map: "idx_orders_customer_id")
}

model payment_methods {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.VarChar(50)
  code       String     @unique @db.VarChar(30)
  is_active  Boolean    @default(true)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  payments   payments[]
}

model payments {
  id                BigInt              @id @default(autoincrement())
  order_id          BigInt              @unique
  payment_method_id BigInt
  amount_paid       Decimal             @db.Decimal(12, 2)
  change_amount     Decimal             @default(0) @db.Decimal(12, 2)
  reference_number  String?             @db.VarChar(100)
  payment_status    payment_status_enum @default(LUNAS)
  paid_at           DateTime?           @default(now()) @db.Timestamptz(6)
  payment_methods   payment_methods     @relation(fields: [payment_method_id], references: [id], map: "fk_payments_method")
  orders            orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_payments_order")
}

model tables {
  id           BigInt            @id @default(autoincrement())
  table_number String            @unique @db.VarChar(20)
  capacity     Int?              @default(4)
  status       table_status_enum @default(TERSEDIA)
  created_at   DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?         @default(now()) @db.Timestamptz(6)
  orders       orders[]
}

model customers {
  id          BigInt   @id @default(autoincrement())
  code        String?  @unique @db.VarChar(30)
  name        String   @db.VarChar(120)
  phone       String?  @unique @db.VarChar(20)
  email       String?  @unique @db.VarChar(120)
  address     String?
  member_tier String?  @default("REGULER") @db.VarChar(20)
  points      Int      @default(0)
  total_spent Decimal  @default(0) @db.Decimal(15, 2)
  notes       String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  orders      orders[]

  @@index([name], map: "idx_customers_name")
  @@index([phone], map: "idx_customers_phone")
}

enum role_code_enum {
  SUPERADMIN
  KASIR
  DAPUR
  PELAYAN
}

enum kitchen_status_enum {
  MENUNGGU
  DIMASAK
  SIAP_SAJI
  SELESAI
}

enum order_status_enum {
  PENDING
  DIPROSES
  SELESAI
  BATAL
}

enum order_type_enum {
  DINE_IN
  TAKE_AWAY
}

enum payment_status_enum {
  PENDING
  LUNAS
  GAGAL
}

enum table_status_enum {
  TERSEDIA
  TERISI
  DIPESAN
}
